<?xml version="1.0" encoding="UTF-8"?>
<!-- edge-gateway: routing, rate limiting (Redis), security headers, correlation ID (ADR-0009). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.waver.platform</groupId>
        <artifactId>waver-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../platform/java/waver-parent/pom.xml</relativePath>
    </parent>

    <groupId>br.com.waver.services.edgegateway</groupId>
    <artifactId>edge-gateway</artifactId>

    <properties>
        <waver.service.group>edgegateway</waver.service.group>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-vault-config</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
