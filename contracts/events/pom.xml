<?xml version="1.0" encoding="UTF-8"?>
<!-- Avro event schemas (ADR-0024). The .avsc files are the source of truth; CI registers them in Apicurio. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.waver.platform</groupId>
        <artifactId>waver-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../platform/java/waver-parent/pom.xml</relativePath>
    </parent>

    <groupId>br.com.waver.contracts</groupId>
    <artifactId>waver-event-schemas</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals><goal>schema</goal></goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}</sourceDirectory>
                            <includes><include>**/*.avsc</include></includes>
                            <excludes><exclude>target/**</exclude></excludes>
                            <stringType>String</stringType>
                            <enableDecimalLogicalType>true</enableDecimalLogicalType>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
