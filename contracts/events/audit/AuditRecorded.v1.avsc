{
  "type": "record",
  "name": "AuditRecorded",
  "namespace": "br.com.waver.events.audit.v1",
  "doc": "Audit transport event written by every service through its outbox (RFC-0006 §13). Topic waver.audit.audit-record.v1, key = orgId.",
  "fields": [
    { "name": "auditId", "type": { "type": "string", "logicalType": "uuid" } },
    { "name": "occurredAt", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "service", "type": "string" },
    { "name": "action", "type": "string", "doc": "Stable action key, e.g. tenant.organization.create" },
    { "name": "outcome", "type": { "type": "enum", "name": "AuditOutcome", "symbols": ["SUCCESS", "DENIED", "FAILURE", "UNKNOWN"], "default": "UNKNOWN" } },
    { "name": "actorId", "type": "string" },
    { "name": "actorType", "type": "string", "doc": "USER, SERVICE or SUPPORT" },
    { "name": "actorOrgId", "type": ["null", { "type": "string", "logicalType": "uuid" }], "default": null },
    { "name": "targetOrgId", "type": ["null", { "type": "string", "logicalType": "uuid" }], "default": null },
    { "name": "resourceType", "type": "string" },
    { "name": "resourceId", "type": "string" },
    { "name": "correlationId", "type": ["null", "string"], "default": null },
    { "name": "details", "type": { "type": "map", "values": "string" }, "default": {}, "doc": "Small non-PII key/values" }
  ]
}
